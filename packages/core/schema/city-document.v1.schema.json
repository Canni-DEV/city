                "commercial": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "industrial": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "park": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 25
