{
  "name": "city-workspace",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "catalog": "pnpm --filter @city/assets generate",
    "check": "biome check .",
    "dev": "pnpm --filter @city/web dev",
    "format": "biome check --write .",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
